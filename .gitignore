# Ignore everything in data/ except data/final/
data/*
!data/final/

# Ignore heavy database files inside data/final/
data/final/*.duckdb

# Ignore raw/archive formats
*.pdf
*.csv
*.xlsx
*.zip

# Python Virtual Environments
venv/
env/
.env
.venv

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class

# OS Generated Files
.DS_Store
Thumbs.db

